#: ../src/plugin.py:1386
msgid "User agent"
msgstr "Käyttäjäagentti"

#: ../src/plugin.py:1657
msgid "WPE WebKit HbbTV 2.0 experiment: test pages on top of enigma2"
msgstr "WPE WebKit HbbTV 2.0 -kokeilu: testisivut enigma2:n päällä"

#: ../src/plugin.py:1441
msgid "Wait before a showing video rectangle moves or goes away."
msgstr "Odota ennen kuin näkyvä videoruutu siirtyy tai poistuu."

#: ../src/plugin.py:1439
msgid ""
"Wait before the first video rectangle appears in graphics (a loading animation must not "
"flash the picture)."
msgstr ""
"Odota ennen ensimmäisen videoruudun ilmestymistä grafiikkaan (latausanimaatio ei saa "
"väläyttää kuvaa)."

#: ../src/plugin.py:1383
msgid ""
"Where they live. Empty = /media/hdd/.wpe-data, or /tmp/wpe-data when there is less than "
"100 MB free there. An absolute path of letters, digits and _ . / -"
msgstr ""
"Tietojen tallennussijainti. Tyhjä = /media/hdd/.wpe-data tai /tmp/wpe-data, jos vapaata "
"tilaa on alle 100 Mt. Absoluuttinen polku, joka sisältää kirjaimia, numeroita sekä merkit "
"_ . / -"

